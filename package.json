{
  "name": "weekendmvp",
  "version": "1.0.0",
  "description": "Weekend MVP Starter Kit Landing Page",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:og && npm run test:links && npm run test:redirects && npm run test:auth && npm run test:security && npm run test:sitemap && npm run test:convex",
    "test:convex": "vitest run convex",
    "test:redirects": "node --experimental-strip-types --test tests/redirects/*.test.mjs && vitest run tests/redirects/middleware.test.ts tests/redirects/tenant-publish-check.test.ts",
    "test:auth": "vitest run tests/auth",
    "test:security": "node --test tests/security/*.test.mjs && vitest run tests/security/wp27-templates.test.tsx tests/security/wp28-templates-tenant.test.tsx",
    "test:sitemap": "node --experimental-strip-types --test tests/sitemap/*.test.mjs",
    "convex:dev": "convex dev",
    "og:generate": "node scripts/generate-og-cards.mjs",
    "og:generate:force": "node scripts/generate-og-cards.mjs --force",
    "og:generate:dry": "node scripts/generate-og-cards.mjs --dry-run",
    "test:og": "node --test tests/og/*.test.mjs",
    "test:links": "node --test tests/links/*.test.mjs",
    "extract:ideas": "node scripts/extract-idea-bodies.mjs",
    "extract:articles": "node scripts/extract-articles-to-mdx.mjs",
    "extract:newsletter": "node scripts/extract-newsletter-to-mdx.mjs",
    "publish:newsletter": "node scripts/publish-newsletter.mjs",
    "seed:convex": "node scripts/seed-convex.mjs",
    "seed:convex:dry": "node scripts/seed-convex.mjs --dry-run",
    "validate:idea-tags": "node scripts/validate-idea-tags.mjs",
    "retag:idea-tags": "node scripts/retag-idea-tags.mjs",
    "retag:idea-tags:apply": "node scripts/retag-idea-tags.mjs --apply",
    "gsc:submit-sitemap": "node scripts/gsc-submit-sitemap.mjs",
    "gsc:inspect-indexing": "node scripts/gsc-inspect-indexing.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "glob": "^13.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.94",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.4",
    "@hookform/resolvers": "^5.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.18.0",
    "next": "^16.3.0",
    "next-mdx-remote-client": "^2.1.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "satori": "^0.10.14",
    "sharp": "^0.35.3",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "cheerio": {
      "undici": "7.29.0"
    },
    "gray-matter": {
      "js-yaml": "3.15.1"
    }
  }
}
