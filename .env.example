# Local Next.js / Convex development
# `CONVEX_DEPLOYMENT` selects a deployment; never commit a real deployment token.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
LEGACY_ORIGIN=

# Public analytics identifiers (Vercel Preview + Production when enabled)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Current server-side publishing and billing integrations
# Store these as encrypted Vercel variables, never in committed files.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_DEFAULT_FORM_ID=
BEEHIIV_DEFAULT_AUTOMATION_ID=
BEEHIIV_IDEAS_AUTOMATION_ID=
BEEHIIV_PAID_AUTOMATION_ID=
BEEHIIV_SHIPABLE_AUTOMATION_ID=
REVALIDATE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Build Platform credit billing (WP24, Stripe test mode only).
# These names are purpose-separated from the legacy shipable Stripe handler.
# Prefer a least-privilege test restricted key. The bridge secret must be the
# same encrypted value in the Next.js and Convex test environments.
PLATFORM_BILLING_MODE=test
PLATFORM_BILLING_APP_ORIGIN=http://localhost:3000
PLATFORM_BILLING_BRIDGE_SECRET=
STRIPE_PLATFORM_TEST_RESTRICTED_KEY=
STRIPE_PLATFORM_TEST_WEBHOOK_SECRET=
STRIPE_PLATFORM_TEST_PRICE_STARTER=
STRIPE_PLATFORM_TEST_PRICE_BUILDER=
STRIPE_PLATFORM_TEST_PRICE_STUDIO=

# Local content tooling; provision in Vercel only if a server runtime needs them.
OPENAI_API_KEY=

# WP26 engine providers (server-side only — never NEXT_PUBLIC_*).
# Adapters fail closed with an explicit configuration error when these are
# missing or blank; they never degrade to a synthesized result.
# Perplexity Sonar Pro, citation-only search/community signal.
PERPLEXITY_API_KEY=
# DataForSEO keyword volume/competition/CPC. An LLM may never substitute for
# these values, so an absent credential fails the report step rather than
# falling back to a model estimate.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# "live" or "fixture" — required, deliberately not defaulted. Defaulting to
# "live" would let a misconfigured deployment spend real money before the
# activation gate; defaulting to "fixture" would serve customers invented
# research that looks exactly like a real report. Note that "fixture" still
# requires the credentials above (placeholder values are fine): only the
# transport is swapped, so the configuration path stays under test.
ENGINE_PROVIDER_MODE=fixture
RECRAFT_API_KEY=
RECRAFT_STYLE_ID=
IDEABROWSER_API_KEY=

# Local operator-only Search Console and quality tooling.
GSC_KEY_FILE=
GSC_SITE_URL=
GSC_SITEMAP_URL=
STRICT=

# Convex deployment environment (not Vercel).
# SITE_URL is already referenced by Convex revalidation and is also required
# for the approved WP21 OAuth/magic-link path. Convex Auth's current manual
# setup additionally requires an RS256 private key and its public JWKS.
SITE_URL=
# Convex provides this deployment HTTP Actions URL automatically at runtime.
CONVEX_SITE_URL=
JWT_PRIVATE_KEY=
JWKS=
# Prevent Convex Auth from logging debug arguments containing email or tokens.
AUTH_LOG_LEVEL=ERROR

# Official Google OAuth names for the owner-approved Google sign-in path.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Owner-approved Resend delivery for the custom phishing-resistant Email flow.
# AUTH_RESEND_FROM must use an explicitly verified sender/domain.
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=
