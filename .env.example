# Local Next.js / Convex development
# `CONVEX_DEPLOYMENT` selects a deployment; never commit a real deployment token.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Convex sets this deployment identity at runtime. Do not override it.
CONVEX_CLOUD_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Set automatically by Vercel on deployed builds; the E6 health probe uses it
# to ensure Convex activates only against the expected public reader commit.
VERCEL_GIT_COMMIT_SHA=

# Public analytics identifiers (Vercel Preview + Production when enabled)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WP44 dashboard. Builder's Hub UI stays hidden unless this is exactly "on".
# Leave empty in production until the owner turns it on (WP44-S10).
NEXT_PUBLIC_BUILDERS_HUB=

# Current server-side publishing and billing integrations
# Store these as encrypted Vercel variables, never in committed files.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_DEFAULT_FORM_ID=
BEEHIIV_DEFAULT_AUTOMATION_ID=
BEEHIIV_IDEAS_AUTOMATION_ID=
BEEHIIV_ACCOUNT_AUTOMATION_ID=
BEEHIIV_PAID_AUTOMATION_ID=
BEEHIIV_SHIPABLE_AUTOMATION_ID=
REVALIDATE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy ship·able payment log hand-off (WP63-S1). Optional, 32+ characters,
# the same value in Convex and Next.js. Set it in Convex first, then in
# Vercel. Unset, the webhook still uses the old public mutation.
LEGACY_PAYMENTS_BRIDGE_SECRET=

# Build Platform credit billing (WP24, Stripe test mode only).
# These names are purpose-separated from the legacy shipable Stripe handler.
# Prefer a least-privilege test restricted key. The bridge secret must be the
# same encrypted value in the Next.js and Convex test environments.
PLATFORM_BILLING_MODE=test
PLATFORM_BILLING_APP_ORIGIN=http://localhost:3000
PLATFORM_BILLING_BRIDGE_SECRET=
STRIPE_PLATFORM_TEST_RESTRICTED_KEY=
STRIPE_PLATFORM_TEST_WEBHOOK_SECRET=
STRIPE_PLATFORM_TEST_PRICE_STARTER=
STRIPE_PLATFORM_TEST_PRICE_BUILDER=
STRIPE_PLATFORM_TEST_PRICE_STUDIO=

# Build Platform anonymous preview generation (WP27).
# Gates the preview-generation mutation so the Next.js route -- the only layer
# that can observe a client IP, and therefore the only place a per-IP rate
# limit can be applied -- is the sole path to artifact creation. Must be at
# least 32 characters and the same value in the Next.js and Convex
# environments. Unset means previews fail closed, never unprotected ones.
PLATFORM_PREVIEW_BRIDGE_SECRET=

# Optional. Pins the origin the preview API accepts browser requests from.
# Leave unset and the request's own Host header is used instead, which is
# correct on Vercel and in local dev -- the gate is never skipped either way,
# so an unset value means "derive it", not "allow anything".
PLATFORM_PREVIEW_APP_ORIGIN=

# Local content tooling; provision in Vercel only if a server runtime needs them.
OPENAI_API_KEY=
# Idea-engine live research (engine:research without --fixture). Not required
# for fixture mode / CI. Never invent keyword metrics — DataForSEO only.
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional user agent for engine:research quote verification (fetches cited
# Reddit / HN threads). Set a descriptive one if Reddit blocks the default.
ENGINE_QUOTE_FETCH_UA=
# Reddit app credentials for quote verification (reddit.com/prefs/apps →
# "script" app). Reddit returns 403 to the public .json endpoint from most
# cloud networks; with these set the engine uses the official OAuth API.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
RECRAFT_API_KEY=
RECRAFT_STYLE_ID=
IDEABROWSER_API_KEY=

# Local operator-only Search Console and quality tooling.
GSC_KEY_FILE=
GSC_SITE_URL=
GSC_SITEMAP_URL=
STRICT=

# Convex deployment environment (not Vercel).
# SITE_URL is already referenced by Convex revalidation and is also required
# for the approved WP21 OAuth/magic-link path. Convex Auth's current manual
# setup additionally requires an RS256 private key and its public JWKS.
SITE_URL=
# Convex provides this deployment HTTP Actions URL automatically at runtime.
CONVEX_SITE_URL=
JWT_PRIVATE_KEY=
JWKS=
# Prevent Convex Auth from logging debug arguments containing email or tokens.
AUTH_LOG_LEVEL=ERROR

# Official Google OAuth names for the owner-approved Google sign-in path.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Owner-approved Resend delivery for the custom phishing-resistant Email flow.
# AUTH_RESEND_FROM must use an explicitly verified sender/domain.
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=

# Headless Chrome for local browser smokes (idea email-gate, etc.).
# Point at a Chromium/Chrome binary on this machine. Example paths:
#   Linux: /usr/bin/google-chrome-stable or /usr/bin/chromium
#   macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# WP46 editorial admin. Deployment-only owner email for `npx convex run admin/superAdmin:bootstrapOwner`
# (set on the Convex deployment with `npx convex env set`, never committed with a value).
SUPER_ADMIN_BOOTSTRAP_EMAIL=
# Local demo only: `local-demo` opts a development server into the fictional fixture workspace.
EDITORIAL_FIXTURE_MODE=
# Operator-only WP46-E5a legacy import. Must name the exact target; never put
# a real admin key in an env file checked into Git or a command argument.
EDITORIAL_IMPORT_CONVEX_URL=
EDITORIAL_IMPORT_ADMIN_KEY=
# Operator-only WP46-E5 engine → private editorial submission. Use an exact
# target deployment and a fresh verified backup; never commit a real admin key.
EDITORIAL_ENGINE_CONVEX_URL=
EDITORIAL_ENGINE_ADMIN_KEY=
# Operator-only WP63-S7 founding offer cohort import. Exact target deployment,
# a fresh verified backup and the dry run's batch id; never commit a real key.
MEMBERSHIP_COHORT_CONVEX_URL=
MEMBERSHIP_COHORT_ADMIN_KEY=

# WP46-E6. Set these on the Convex deployment only after the public reader
# build and rollback/removal probes pass. Keep ENABLED unset during E7 staging.
EDITORIAL_RELEASE_ENABLED=
EDITORIAL_PUBLIC_SITE_URL=
EDITORIAL_READER_COMMIT=
# Isolated E7 cloud-restore drills only. Set these on the non-serving Convex
# deployment, never in this file or on the live backend with a real value.
EDITORIAL_STAGING_BACKEND_URL=
EDITORIAL_STAGING_BYPASS_SECRET=
# Next.js provides this itself ("development" for `next dev`, "production" for `next build` and
# `next start`) and inlines it at build time; an env-file value never overrides it. Named only
# because the editorial production gate reads it. Leave it unset.
NODE_ENV=
